Meta.DisplayName=Garry's Mod TTT
Meta.Description=Garry's Mod Dedicated Server mit TTT-Einstellungen und Waffen-/Shop-GUI
Meta.Arch=x86_64
Meta.Author=Hoody
Meta.URL=https://store.steampowered.com/app/4020/Garrys_Mod/
Meta.MinAMPVersion=2.4.6.6
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.Prerequsites=[]
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$GamePort1}
Meta.AppConfigId=3c52eef3-7b14-4bc0-b877-87592570f4c1
Meta.OS=3
Meta.ConfigManifest=gmodtttconfig.json
Meta.MetaConfigManifest=gmodtttmetaconfig.json
Meta.ConfigRoot=gmodttt.kvp
Meta.DisplayImageSource=steam:4020
App.DisplayName=Garry's Mod TTT
App.RootDir=./gmodttt/
App.BaseDirectory=./gmodttt/4020/
App.WorkingDir=4020
App.ExecutableWin=4020/srcds.exe
App.ExecutableLinux=4020/srcds_linux
App.AdminMethod=SourceRCON
App.HasReadableConsole=true
App.HasWritableConsole=true
App.CommandLineArgs=-game garrysmod -console -usercon -ip {{$ApplicationIPBinding}} -port {{$GamePort1}} +maxplayers {{$MaxUsers}} +gamemode terrortown +map {{map}} +rcon_password "{{$RemoteAdminPassword}}" {{$FormattedArgs}}
App.CommandLineParameterFormat={0} "{1}"
App.CommandLineParameterDelimiter= 
App.RapidStartup=false
App.ExitMethod=String
App.ExitString=quit
App.ExitTimeout=30
App.ApplicationIPBinding=0.0.0.0
App.AdminPortRef=GamePort1
App.PrimaryApplicationPortRef=GamePort1
App.MaxUsers=24
App.UseRandomAdminPassword=True
App.RemoteAdminPassword=
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=30
App.RCONConnectRetrySeconds=15
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.TemplateMatchRegex={{(\$?[\w]+)}}
App.AppSettings={"map": "ttt_67thway_v14"}
App.Ports=@IncludeJson[gmodtttports.json]
App.UpdateSources=@IncludeJson[gmodtttupdates.json]
App.EnvironmentVariables={"LD_LIBRARY_PATH": "{{$FullBaseDir}}:{{$FullBaseDir}}bin:{{$FullBaseDir}}garrysmod/bin:%LD_LIBRARY_PATH%", "SteamAppId": "4020"}
Console.AppReadyRegex=^(VAC secure mode is activated\.|Connection to Steam servers successful\.|Assigned anonymous gameserver Steam ID.*)$
Console.UserJoinRegex=^Client "(?<username>.+?)" spawned in server <(?<userid>STEAM_[0-9:_A-Z]+)>.*$
Console.UserLeaveRegex=^Dropped (?<username>.+?) from server \(.*\)$
